; Fedora 45.24 omits passwd_t from systemd_homed_dbus_chat callers.
; pam_systemd_home in passwd/chpasswd must query/change the caller's record.
; Match the two directions of Fedora's systemd_homed_dbus_chat interface:
; https://github.com/fedora-selinux/selinux-policy/blob/5df11316337c290e108c8e8df637c31e87494c08/policy/modules/system/systemd-homed.if
; D-Bus policy, polkit and homed's credential checks still authorize operations.
(allow passwd_t systemd_homed_t (dbus (send_msg)))
(allow systemd_homed_t passwd_t (dbus (send_msg)))
; Linux pidfs is also probed by homework's fsck spawn path (F45 kernel 7.3).
; The manager already has Fedora's fs_getattr_pidfs permission; the worker
; needs the same metadata-only access. No pidfd/process access is granted.
(allow systemd_homework_t pidfs_t (filesystem (getattr)))
