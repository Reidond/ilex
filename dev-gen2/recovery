#!/usr/bin/bash
set -eu
chvt 1
stty -echo -echonl
trap 'stty echo' EXIT
seed=$(mktemp -d /run/ilex-gen2-recovery.XXXXXXXX)
trap 'stty echo; if mountpoint -q "$seed"; then umount "$seed"; fi; rmdir "$seed"' EXIT
udevadm settle --timeout=20
mount -t iso9660 -o ro,nosuid,nodev,noexec LABEL=ILEX_GEN2 "$seed"
# The stock dev fixture has a documented disposable response. Qualification
# can replace its digest without writing the response to media.
expected=adde69c3515636224221530f10b5db1dc9237849128cc8acc9d341e8bbdc31af
if test -e "$seed/recovery.sha256"; then expected=$(< "$seed/recovery.sha256"); fi
printf '\033[2J\033[HILEX GEN2 RECOVERY KEY\r\n'
IFS= read -r -t 360 recovery
actual=$(printf '%s' "$recovery" | sha256sum)
unset recovery
[[ "${actual%% *}" == "$expected" ]]
printf '\033[2J\033[HRECOVERY KEY ACCEPTED\r\n'
install -d -m 0700 /var/lib/ilex-gen2
printf '%s\n' "$(cat /proc/sys/kernel/random/boot_id)" > /var/lib/ilex-gen2/recovery-ok
