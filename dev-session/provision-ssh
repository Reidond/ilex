#!/usr/bin/python3 -I
import os
import subprocess
from pathlib import Path

# Native launches deliver their pinned identity. bcvk's disk installer first
# boots this same image without that firmware channel; it needs its ordinary
# ephemeral SSH readiness path, with a volatile key that never enters the disk.
source = Path('/sys/firmware/qemu_fw_cfg/by_name/opt/ilex/ssh-host-key/raw')
if not source.exists():
    subprocess.run(['/usr/sbin/modprobe', 'qemu_fw_cfg'], check=True)
os.makedirs('/run/ilex-dev', mode=0o700, exist_ok=True)
def label(path, kind):
    # bcvk's ephemeral installation root has no active SELinux mount/labels.
    # Installed native boots keep their normal enforcing policy and receive a
    # full context, which also works for a newly created, unlabeled tmpfs file.
    if Path('/sys/fs/selinux/enforce').exists():
        subprocess.run(['/usr/bin/chcon', f'system_u:object_r:{kind}:s0', str(path)], check=True)
label('/run/ilex-dev', 'sshd_var_run_t')
target = Path('/run/ilex-dev/ssh_host_ed25519_key')
if source.exists():
    key = source.read_bytes()
    if not 1 <= len(key) <= 4096 or not key.startswith(b'-----BEGIN OPENSSH PRIVATE KEY-----'):
        raise SystemExit('invalid development host identity')
    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'wb') as stream:
        stream.write(key)
elif not target.exists():
    subprocess.run(['/usr/bin/ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-f', str(target)], check=True)
# This is a disposable guest's /run, never the host or production image.
label(target, 'sshd_key_t')
