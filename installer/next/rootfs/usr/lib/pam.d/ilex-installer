# PAM service of ilex-installer-session.service. systemd opens (it does not
# authenticate) the session: the account stack and pam_setcred run, and
# pam_systemd registers the session with logind, which gives the compositor
# seat0's DRM and input devices without root. No password is ever asked, and
# only the installer's own user may open a session through this service.
auth       required     pam_succeed_if.so user = ilex-installer quiet
auth       required     pam_permit.so
account    required     pam_succeed_if.so user = ilex-installer quiet
account    required     pam_permit.so
password   required     pam_deny.so
session    required     pam_succeed_if.so user = ilex-installer quiet
session    required     pam_permit.so
session    required     pam_env.so
# Required, not optional: without a logind session the compositor gets no
# devices and the unit's start must fail visibly rather than half-work.
session    required     pam_systemd.so
