[Unit]
Description=ilex installer session (kiosk compositor on tty1)
Documentation=https://github.com/Reidond/ilex
# A logind session for an unprivileged user on the first virtual terminal
# (the pattern kiosk compositors use under systemd): the compositor starts as
# ilex-installer, and logind hands it seat0's DRM and input devices.
After=systemd-user-sessions.service systemd-logind.service systemd-sysusers.service systemd-tmpfiles-setup.service
Wants=systemd-logind.service
Conflicts=getty@tty1.service
After=getty@tty1.service
ConditionPathExists=/usr/share/ilex-installer/edition.json
# Three starts in five minutes, then the unit gives up (start-limit-hit) and
# stays failed. ilex-installer-fallback.service sees that final state and says
# so on tty1; there is no OnFailure= here, which would fire after every failed
# attempt and not only after the last.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=ilex-installer
PAMName=ilex-installer
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
# Marker lines on the serial console (the user cannot open /dev/ttyS0 itself).
SupplementaryGroups=dialout
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_CLASS=user
# Fixed test-only credentials, read by the session script and the interface:
# ilex.installer.fault=session makes the session fail to start;
# ilex.installer.serial-test=unavailable|backpressure makes the serial mirror
# of the markers fail. They can only make the installer fail or stay quiet.
ImportCredential=ilex.installer.fault
ImportCredential=ilex.installer.serial-test
ExecStart=/usr/libexec/ilex-installer/session
# The session script exits non-zero whenever either of its processes ends, but
# any end of this unit's main process, clean or not, is a failed session.
Restart=always
RestartSec=2
# What the script leaves behind is killed after this long, so that the next
# attempt does not start while the last compositor still holds seat0.
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
