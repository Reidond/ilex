[Unit]
Description=ilex installer: say why the session did not start
# The session unit gives up after three starts in five minutes. This unit
# watches for that final state (ActiveState=failed; Restart=always means a
# session that will be retried is never "failed" for long) and then says so on
# tty1, once. It is level-triggered on purpose: an OnFailure= start would fire
# after every failed attempt, merge into a run still in progress, and hit its
# own start limit. No text-mode installer: the person is told where to look,
# and the shell on tty2 stays available.
ConditionPathExists=/usr/share/ilex-installer/edition.json

[Service]
Type=simple
StandardInput=null
StandardOutput=journal
StandardError=journal
ExecStart=/usr/libexec/ilex-installer/fallback
# The message must stay on screen: start the watcher again if something kills it.
Restart=on-failure
RestartSec=1
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
