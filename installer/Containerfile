# The ilex installer: fedora-bootc plus Anaconda, a network installer. It
# carries no ilex image: its kickstart installs the newest installer composition from the
# registry (so one ISO stays current, and fits GitHub's 2 GiB release asset
# limit). `image-builder` turns this container into the ISO
# (`cargo xtask iso`). Follows osbuild's example for an Anaconda installer
# container:
# https://osbuild.org/docs/developer-guide/projects/image-builder/advanced/bootc/isos/
# Assemble the small installer configuration on scratch: each COPY here avoids
# committing the full Anaconda root, and table changes do not rebuild dracut.
FROM scratch AS installer-config
COPY --from=generated iso.yaml /usr/lib/image-builder/bootc/iso.yaml
COPY --from=generated compositions.json /usr/share/ilex-installer/compositions.json
COPY --from=generated ilex.yaml /etc/containers/registries.d/ilex.yaml
COPY --from=generated ilex.pub /etc/pki/containers/ilex.pub
COPY policy.json /etc/containers/policy.json
COPY 90-ilex-installer.toml /usr/lib/bootc/install/90-ilex-installer.toml
COPY --chmod=0755 chooser/ilex-installer-choice /usr/libexec/ilex-installer/ilex-installer-choice
COPY --chmod=0755 chooser/chooser-session chooser/chooser-kiosk /usr/libexec/ilex-installer/
COPY chooser/ilex-installer-chooser.service /usr/lib/systemd/system/
COPY chooser/anaconda-chooser.conf /usr/lib/systemd/system/anaconda.service.d/10-ilex-chooser.conf
COPY chooser/anaconda-chooser.conf /usr/lib/systemd/system/anaconda-direct.service.d/10-ilex-chooser.conf
COPY interactive-defaults.ks /usr/share/anaconda/interactive-defaults.ks

FROM quay.io/fedora/fedora-bootc:45
LABEL org.opencontainers.image.source="https://github.com/Reidond/ilex"

# The Fedora release the installer reports as its version (keep in step with
# the FROM above).
ARG PRODUCT_VERSION=45

# The anaconda metapackage selects GTK on fedora-bootc's basic identity.
# Keep Firefox as the web interface's browser: slitherer is a weak dependency
# that adds a second browser and QtWebEngine. GTK also used to bring Wi-Fi.
RUN --mount=type=cache,id=ilex-dnf,target=/var/cache/libdnf5,sharing=locked \
    dnf -y install --setopt=keepcache=1 --exclude=slitherer \
        anaconda-core anaconda-tui anaconda-webui NetworkManager-wifi \
        anaconda-install-img-deps \
        anaconda-dracut \
        dracut-config-generic \
        dracut-network \
        net-tools \
        grub2-efi-x64-cdboot \
        plymouth \
        default-fonts-core-sans \
        default-fonts-other-sans \
        jq \
        xorrisofs \
        squashfs-tools && \
    ! rpm -q anaconda-gui && ! rpm -q slitherer && \
    mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

# The ISO has to stay under GitHub's 2 GiB limit per release asset (a stock
# build was 1.98 GiB). An installer doesn't need GPU firmware, Vulkan drivers,
# video acceleration, user-mode emulators or audio firmware; removing them
# before the initramfs is built (it is `--no-hostonly` and would carry the
# firmware, twice: in the squashfs and on the ISO) shrinks both. Wi-Fi and NIC
# firmware stay.
RUN rpm -qa 'nvidia-gpu-firmware' 'amd-gpu-firmware' 'intel-gpu-firmware' \
        'mesa-vulkan-drivers' 'intel-mediasdk' 'qemu-user-static*' \
        'intel-audio-firmware' 'cirrus-audio-firmware' \
    | xargs -r rpm -e --nodeps

# Product identity. Anaconda takes its name, version and "is this a final
# release" from /.buildstamp (the file lorax writes into an installer image).
# Without it the installer calls itself "anaconda bluesky" and shows a red
# pre-release banner.
RUN printf '%s\n' \
        '[Main]' \
        'Product=ilex' \
        "Version=${PRODUCT_VERSION}" \
        'BugURL=https://github.com/Reidond/ilex/issues' \
        'IsFinal=True' \
        'UUID=ilex-installer.x86_64' \
        > /.buildstamp && \
    cp --remove-destination /usr/lib/os-release /etc/os-release && \
    sed -i 's/^NAME=.*/NAME="ilex"/; s/^PRETTY_NAME=.*/PRETTY_NAME="ilex"/' /etc/os-release

# Cockpit reads the installer's os-release for the heading, title and review.
# Only /etc is branded; Fedora's ID/VERSION_ID and /usr/lib/os-release stay.
# The kickstart's apply helper refines PRETTY_NAME with the chosen composition.

# What `lorax` normally does to make `anaconda` run; this is the bare minimum.
RUN echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd && \
    echo "install::14438:0:99999:7:::" >> /etc/shadow && \
    passwd -d root
RUN mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives && \
    mv /etc/yum.repos.d /etc/anaconda.repos.d && \
    ln -s /lib/systemd/system/anaconda.target /etc/systemd/system/default.target && \
    rm -v /usr/lib/systemd/system-generators/systemd-gpt-auto-generator
RUN ln -s /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service
RUN mkdir -p /usr/lib/systemd/logind.conf.d
COPY <<EOT /usr/lib/systemd/logind.conf.d/anaconda-shell.conf
[Login]
ReserveVT=2
EOT

# Rebuild the initramfs with the anaconda dracut module (and the buildstamp,
# as lorax does).
RUN mkdir "$(realpath /root)" && \
    kernel=$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version') && \
    DRACUT_NO_XATTR=1 dracut --force -v --zstd --reproducible --no-hostonly \
        --add "anaconda" \
        --install /.buildstamp \
        "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"

# Anaconda runs as root, which user-level pipewire refuses by default.
RUN mkdir /etc/systemd/user/pipewire.service.d/
COPY <<EOT /etc/systemd/user/pipewire.service.d/allowroot.conf
[Unit]
ConditionUser=
EOT
RUN mkdir /etc/systemd/user/pipewire.socket.d/
COPY <<EOT /etc/systemd/user/pipewire.socket.d/allowroot.conf
[Unit]
ConditionUser=
EOT

# Kickstart defaults: install the newest ilex image and keep tracking ghcr.
# Anaconda still asks for the disk, the user and everything else.
COPY --from=installer-config / /
RUN mkdir -p /usr/lib/systemd/system/anaconda.target.wants && \
    ln -s ../ilex-installer-chooser.service \
        /usr/lib/systemd/system/anaconda.target.wants/ilex-installer-chooser.service
