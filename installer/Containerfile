# The ilex installer: the base (fedora-bootc plus Anaconda, `installer/base/`)
# with the kickstart for one payload on top. `cargo xtask iso` passes the base
# it built or pulled; image-builder turns the result into the ISO and embeds
# the ilex image as the payload.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# The ilex image the ISO installs, as it is named in the ISO's container
# storage, and the reference installed machines update from.
ARG PAYLOAD_REF
ARG TARGET_IMGREF=ghcr.io/reidond/ilex:latest

# Kickstart defaults: install the embedded ilex image and keep tracking ghcr.
# Anaconda still asks for the disk, the user and everything else.
COPY interactive-defaults.ks /tmp/interactive-defaults.ks
RUN test -n "$PAYLOAD_REF" || { echo "build with --build-arg PAYLOAD_REF=<image@sha256:...>" >&2; exit 1; }; \
    sed -e "s|@PAYLOAD_REF@|${PAYLOAD_REF}|g" -e "s|@TARGET_IMGREF@|${TARGET_IMGREF}|g" \
        /tmp/interactive-defaults.ks > /usr/share/anaconda/interactive-defaults.ks && \
    rm /tmp/interactive-defaults.ks && \
    cat /usr/share/anaconda/interactive-defaults.ks
