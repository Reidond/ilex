[Unit]
Description=ilex: choose what to install
After=systemd-logind.service systemd-user-sessions.service plymouth-quit-wait.service
Before=anaconda.service anaconda-direct.service
# Automated, text and remote installations use apply without a local chooser.
ConditionKernelCommandLine=!ilex.composition
ConditionKernelCommandLine=!inst.ks
ConditionKernelCommandLine=!inst.text
ConditionKernelCommandLine=!inst.cmdline
ConditionKernelCommandLine=!inst.webui.remote
ConditionKernelCommandLine=!inst.rdp
ConditionPathExists=!/run/install/ks.cfg

[Service]
Type=oneshot
ExecStart=/usr/libexec/ilex-installer/chooser-session
TimeoutStartSec=infinity
UMask=0077

[Install]
WantedBy=anaconda.target
