#!/usr/bin/python3 -IS
"""Own the chooser's processes and PAM/logind session through teardown."""

import ctypes
import json
import os
from pathlib import Path
import re
import runpy
import signal
import subprocess
import sys
import time

RUN = Path("/run/ilex-installer")
PROGRAM = "/usr/libexec/ilex-installer/"
stopping = False
serial = runpy.run_path(str(Path(__file__).with_name("diagnostics.py")))["emit"]


def stop(unused_signal, unused_frame):
    global stopping
    stopping = True


def write(name, value):
    temporary = RUN / (name + ".tmp")
    temporary.write_text(json.dumps(value) + "\n", encoding="utf-8")
    temporary.replace(RUN / name)


def read(name):
    try:
        return json.loads((RUN / name).read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}


def processes():
    result = {}
    for path in Path("/proc").glob("[0-9]*/stat"):
        try:
            fields = path.read_text().rsplit(") ", 1)[1].split()
            result[int(path.parent.name)] = {
                "parent": int(fields[1]), "group": int(fields[2]),
                "sid": int(fields[3]), "start": int(fields[19]), "state": fields[0]}
        except (OSError, ValueError, IndexError):
            continue
    return result


def identity(pid):
    return {"pid": pid, "start": processes()[pid]["start"]}


def alive(item, snapshot=None):
    current = (snapshot if snapshot is not None else processes()).get(item["pid"])
    return current is not None and current["start"] == item["start"]


def command(*args):
    return subprocess.run(args, capture_output=True, text=True, timeout=4)


def sessions():
    result = command("/usr/bin/loginctl", "list-sessions", "--no-legend", "--no-pager")
    if result.returncode:
        raise RuntimeError("cannot inspect logind sessions")
    return [line.split()[0] for line in result.stdout.splitlines() if line.strip()]


def session_id(value):
    if not re.fullmatch(r"[a-zA-Z0-9]+", value):
        raise RuntimeError("invalid logind session ID")
    return value


def signal_process(item, sig):
    if alive(item):
        try:
            os.kill(item["pid"], sig)
        except ProcessLookupError:
            pass


class Supervisor:
    def __init__(self):
        self.server = self.launcher = None
        self.owned = {}
        self.session_ids = set()
        self.forced = False
        # Adopt orphaned Firefox/compositor descendants after a crash. This
        # changes only this process, not the machine's init or other sessions.
        if ctypes.CDLL(None, use_errno=True).prctl(36, 1, 0, 0, 0) != 0:
            raise OSError(ctypes.get_errno(), "PR_SET_CHILD_SUBREAPER")

    def collect(self):
        snapshot = processes()
        descendants = {os.getpid()}
        while True:
            found = {pid for pid, item in snapshot.items() if item["parent"] in descendants}
            expanded = descendants | found
            if expanded == descendants:
                break
            descendants = expanded
        for pid in descendants - {os.getpid()}:
            self.owned[(pid, snapshot[pid]["start"])] = {"pid": pid, "start": snapshot[pid]["start"]}
        direct = {p.pid for p in (self.server, self.launcher) if p is not None}
        for pid in descendants - direct - {os.getpid()}:
            if snapshot[pid]["parent"] == os.getpid():
                try:
                    os.waitpid(pid, os.WNOHANG)
                except ChildProcessError:
                    pass
        record = read("session.json")
        if record.get("session"):
            self.session_ids.add(session_id(record["session"]))
        return snapshot

    def discover_session(self):
        # Cover failure after pam_open_session but before the child could
        # record XDG_SESSION_ID. Select by our exact launcher, never by user.
        if self.launcher is not None:
            for sid in sessions():
                leader = command("/usr/bin/loginctl", "show-session", session_id(sid),
                                 "--property=Leader", "--value")
                if leader.returncode == 0 and leader.stdout.strip() == str(self.launcher.pid):
                    self.session_ids.add(sid)

    def wait_launcher(self, seconds):
        deadline = time.monotonic() + seconds
        while self.launcher is not None and self.launcher.poll() is None:
            self.collect()
            if time.monotonic() >= deadline:
                return False
            time.sleep(0.1)
        return True

    def signal_children(self, sig):
        snapshot = self.collect()
        launcher = self.launcher.pid if self.launcher is not None else None
        # The launcher's child calls setsid. Signal that actual group while
        # leaving the launcher alive to wait for its child and close PAM.
        child = read("session.json").get("child")
        if child and alive(child, snapshot):
            group = snapshot[child["pid"]]["group"]
            if group == child["pid"]:
                try:
                    os.killpg(group, sig)
                except ProcessLookupError:
                    pass
        # Include escaped groups/orphans. Start times protect against PID reuse.
        for item in list(self.owned.values()):
            if item["pid"] != launcher:
                signal_process(item, sig)

    def cleanup(self):
        started = time.monotonic()
        self.collect()
        self.discover_session()
        if self.server is not None and self.server.poll() is None:
            self.server.terminate()
            try:
                self.server.wait(timeout=3)
            except subprocess.TimeoutExpired:
                self.server.kill()
                self.server.wait(timeout=2)
        # Normal handoff: let chooser-kiosk notice server exit, close Firefox
        # and the compositor, then let the untouched launcher close PAM.
        if not self.wait_launcher(15):
            self.forced = True
            self.signal_children(signal.SIGTERM)
            if not self.wait_launcher(3):
                self.signal_children(signal.SIGKILL)
                self.wait_launcher(5)
        self.collect()
        self.signal_children(signal.SIGTERM)
        deadline = time.monotonic() + 2
        while time.monotonic() < deadline:
            self.collect()
            if not any(alive(p) for p in self.owned.values()):
                break
            time.sleep(0.1)
        self.signal_children(signal.SIGKILL)
        self.discover_session()
        # Upstream signals itself if its child died by signal, bypassing PAM
        # close. Explicitly retire this old session/scope in that case too.
        for sid in self.session_ids:
            if sid in sessions():
                command("/usr/bin/loginctl", "terminate-session", sid)
            command("/usr/bin/systemctl", "stop", "session-" + sid + ".scope")
        if self.launcher is not None and not self.wait_launcher(3):
            self.forced = True
            self.launcher.kill()
            self.launcher.wait(timeout=2)
        deadline = time.monotonic() + 5
        while True:
            self.collect()
            live = [p for p in self.owned.values() if alive(p)]
            old_sessions = self.session_ids.intersection(sessions())
            # Check the kernel's child list too: a fork/exit during a /proc
            # snapshot must not hide a newly adopted orphan from this audit.
            children = Path(f"/proc/self/task/{os.getpid()}/children").read_text().split()
            if not live and not old_sessions and not children:
                break
            if time.monotonic() >= deadline:
                raise RuntimeError("chooser teardown incomplete; refusing Anaconda startup")
            self.signal_children(signal.SIGKILL)
            time.sleep(0.1)
        write("closed.json", {"pids": list(self.owned.values()), "sessions": sorted(self.session_ids),
                              "forced": self.forced, "cleanup_seconds": time.monotonic() - started,
                              "test": read("session.json").get("test", ""),
                              "exit": read("session.json").get("exit", ""),
                              "browser_status": read("session.json").get("browser_status")})
        (RUN / "url").unlink(missing_ok=True)

    def run(self):
        checks = []
        credential = Path("/run/credentials/@system/ilex.chooser.self-check")
        if credential.is_file() and credential.read_text().strip() == "1":
            checks = ["--self-check"]
        with (RUN / "url").open("w", encoding="utf-8") as url:
            self.server = subprocess.Popen(["/usr/bin/python3", "-I", "-S", PROGRAM + "ilex-installer-choice",
                                            "serve", *checks], stdout=url)
        deadline = time.monotonic() + 10
        while not (RUN / "url").stat().st_size:
            if stopping or self.server.poll() is not None or time.monotonic() >= deadline:
                return
            time.sleep(0.1)
        self.launcher = subprocess.Popen(["/usr/libexec/anaconda/run-in-new-session", "--user", "root",
                                         "--service", "anaconda", "--session-type", "wayland",
                                         "--session-class", "user", "--vt", "6",
                                         PROGRAM + "chooser-kiosk", str(self.server.pid)])
        while not stopping and self.server.poll() is None and self.launcher.poll() is None:
            self.collect()
            time.sleep(0.2)


def kiosk(server):
    record = {"child": identity(os.getpid()), "session": os.environ.get("XDG_SESSION_ID", ""), "test": ""}
    credential = Path("/run/credentials/@system/ilex.chooser.lifecycle")
    if credential.is_file():
        mode = credential.read_text().strip()
        if mode in ("crash", "delay", "hung"):
            record["test"] = mode
    write("session.json", record)
    children = []
    try:
        environment = os.environ | {"XDG_SESSION_TYPE": "wayland", "WAYLAND_DISPLAY": "wl-ilex-chooser"}
        compositor = subprocess.Popen(["/usr/bin/gnome-kiosk", "--wayland", "--wayland-display",
                                       "wl-ilex-chooser"], env=environment)
        children.append(compositor)
        deadline = time.monotonic() + 10
        while not (Path(os.environ["XDG_RUNTIME_DIR"]) / "wl-ilex-chooser").is_socket():
            if stopping or compositor.poll() is not None or time.monotonic() >= deadline:
                return
            time.sleep(0.1)
        profile = command("/usr/bin/mktemp", "-d", str(RUN / "firefox.XXXXXX"))
        profile.check_returncode()
        profile = profile.stdout.strip()
        subprocess.run(["/usr/bin/cp", "-a", "/usr/share/anaconda/firefox-theme/default/.", profile], check=True)
        browser = subprocess.Popen(["/usr/bin/firefox", "--kiosk", "--new-instance", "--profile", profile,
                                    (RUN / "url").read_text().strip()],
                                   env=environment | {"HOME": str(RUN), "MOZ_ENABLE_WAYLAND": "1"})
        children.append(browser)
        serial("ILEX-CHOOSER-BROWSER READY")
        born = time.monotonic()
        reason = "stopped"
        while not stopping and compositor.poll() is None and browser.poll() is None:
            try:
                os.kill(server, 0)
            except ProcessLookupError:
                reason = "server"
                break
            if record["test"] == "crash" and time.monotonic() - born > 10:
                serial("ILEX-CHOOSER-FAULT browser-crash")
                browser.kill()  # Fixed local e2e fault; no HTTP control endpoint.
            time.sleep(0.1)
        record["exit"] = "browser" if browser.poll() is not None else reason
        record["browser_status"] = browser.poll()
        write("session.json", record)
    finally:
        # These fixed e2e delays leave the real browser/compositor and seat
        # alive, distinguishing waiting from premature launcher termination.
        if record["test"] in ("delay", "hung"):
            delay = 4 if record["test"] == "delay" else 30
            both_live = len(children) == 2 and all(child.poll() is None for child in children)
            serial(f"ILEX-CHOOSER-FAULT delay={delay} both-live={int(both_live)}")
            time.sleep(delay)
        for child in children:
            if child.poll() is None:
                child.terminate()
        deadline = time.monotonic() + 5
        while any(child.poll() is None for child in children) and time.monotonic() < deadline:
            time.sleep(0.1)
        for child in children:
            if child.poll() is None:
                child.kill()
            child.wait(timeout=2)


def verify():
    if not (RUN / "started").exists():
        return  # Kernel/OEMDRV conditions skipped the chooser entirely.
    record = read("closed.json")
    if not record or any(alive(p) for p in record["pids"]) or set(record["sessions"]).intersection(sessions()):
        raise RuntimeError("old chooser processes/session remain; refusing Anaconda startup")
    serial("ILEX-CHOOSER-HANDOFF " + json.dumps(record | {"live": 0, "old_sessions": 0}))


def main():
    os.umask(0o077)
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    if sys.argv[1:] == ["verify"]:
        verify()
    elif sys.argv[1:2] == ["kiosk"]:
        kiosk(int(sys.argv[2]))
    else:
        RUN.mkdir(mode=0o700, parents=True, exist_ok=True)
        if (RUN / "choice").exists():
            return
        (RUN / "started").touch()
        for name in ("closed.json", "session.json", "url"):
            (RUN / name).unlink(missing_ok=True)
        supervisor = Supervisor()
        try:
            supervisor.run()
        finally:
            supervisor.cleanup()


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"ilex chooser lifecycle: {error}", file=sys.stderr, flush=True)
        try:
            serial(f"ILEX-CHOOSER-LIFECYCLE FAILED: {error}")
        except OSError:
            pass
        sys.exit(1)
