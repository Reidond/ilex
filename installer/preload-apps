#!/bin/bash
# Run as PID 1 by unshare from Anaconda's --nochroot %post. A bootc deployment has
# empty runtime directories: Rust's captured subprocesses need /dev/null,
# and Flatpak/OSTree need /proc (including the kernel boot ID) and /sys.
set -euo pipefail

target=${1:?installed root required}
readlink /proc/self/ns/pid > "$target/var/lib/ilex/apps/installer-pidns"
echo "Preloading system apps in $target (private mount and PID namespaces)."
for path in dev/null proc/sys/kernel/random/boot_id; do
    if [ ! -e "$target/$path" ]; then
        echo "Target runtime /$path is absent before the bind mounts."
    fi
done

# No installer disks, sockets or writable runtime state enter the chroot.
mount -t tmpfs -o mode=0755,nodev,nosuid,noexec tmpfs "$target/dev"
for device in null zero full random urandom; do
    touch "$target/dev/$device"
    mount --bind "/dev/$device" "$target/dev/$device"
done
ln -s /proc/self/fd "$target/dev/fd"
ln -s fd/0 "$target/dev/stdin"
ln -s fd/1 "$target/dev/stdout"
ln -s fd/2 "$target/dev/stderr"
mount -t proc -o nodev,nosuid,noexec proc "$target/proc"
mount -t sysfs -o ro,nodev,nosuid,noexec sysfs "$target/sys"
mount -t tmpfs -o mode=0755,nodev,nosuid,noexec tmpfs "$target/run"

# Resolve the target's symlink inside its root, then expose just the DNS file.
resolver=$(chroot "$target" readlink -m /etc/resolv.conf)
if [[ "$resolver" == /run/* ]]; then
    mkdir -p "$target$(dirname "$resolver")"
    touch "$target$resolver"
fi
mount --bind "$(readlink -e /etc/resolv.conf)" "$target$resolver"
mount -o remount,bind,ro "$target$resolver"
exec chroot "$target" /usr/bin/ilexctl apps sync
