# image-builder >= 89 for `cargo xtask iso` on machines whose own image-builder
# is older or missing. Fedora 45's stable repository has 87; the `generic-iso`
# image type needs 89 (updates-testing). CI installs the same package directly.
FROM quay.io/fedora/fedora:45
RUN dnf -y install --enablerepo=updates-testing image-builder podman skopeo && dnf clean all
