#!/bin/sh
# No credentials in %post, its stdout, the journal, kickstart or the chooser.
# tty8 is reserved and has no Anaconda shell/getty; tty6 belongs to the GUI.
# Failure preserves every
# LUKS slot and the local maintenance account, and prevents an automatic reboot.
set -eu
if [ -d /mnt/sysroot/etc ]; then
    target=/mnt/sysroot
else
    target=/mnt/sysimage
fi
# A refusal is handled by completion on the local console. Only a verified
# plaintext layout may skip the console entirely.
if layout=$(/usr/bin/ilex-enroll layout --root "$target" 2>/dev/null) && [ "$layout" = null ]; then
    exit 0
fi
chvt 8
trap 'printf "\033[2J\033[3J\033[H" > /dev/tty8' EXIT HUP INT TERM
if /usr/bin/ilex-enroll complete --root "$target" --tty /dev/tty8; then
    chvt 6
else
    echo 'ilex encrypted completion failed. Passphrase retained; use tty2 to retry the local completion command.' >&2
    exit 1
fi
