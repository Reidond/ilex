# The installer environment for the ilex ISO: fedora-bootc plus Anaconda,
# without anything that depends on the payload. `cargo xtask iso` builds it
# once per content hash and Fedora release and reuses it from
# ghcr.io/<owner>/ilex-installer-base (CI) or the local image store, because
# its ~540 packages and the initramfs take most of the time of an ISO build.
# `installer/Containerfile` adds the kickstart on top.
#
# Follows osbuild's example for an Anaconda installer container:
# https://osbuild.org/docs/developer-guide/projects/image-builder/advanced/bootc/isos/
FROM quay.io/fedora/fedora-bootc:45
LABEL org.opencontainers.image.source="https://github.com/Reidond/ilex"

# The Fedora release the installer reports as its version.
ARG PRODUCT_VERSION=45

RUN --mount=type=cache,id=ilex-dnf,target=/var/cache/libdnf5,sharing=locked \
    dnf -y install --setopt=keepcache=1 \
        anaconda \
        anaconda-install-img-deps \
        anaconda-dracut \
        dracut-config-generic \
        dracut-network \
        net-tools \
        grub2-efi-x64-cdboot \
        plymouth \
        default-fonts-core-sans \
        default-fonts-other-sans \
        google-noto-sans-cjk-fonts \
        jq \
        xorrisofs \
        squashfs-tools && \
    mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

# How image-builder lays out the ISO: volume label and boot menu.
COPY iso.yaml /usr/lib/image-builder/bootc/iso.yaml

# Product identity. Anaconda takes its name, version and "is this a final
# release" from /.buildstamp (the file lorax writes into an installer image).
# Without it the installer calls itself "anaconda bluesky" and shows a red
# pre-release banner.
RUN printf '%s\n' \
        '[Main]' \
        'Product=ilex' \
        "Version=${PRODUCT_VERSION}" \
        'BugURL=https://github.com/Reidond/ilex/issues' \
        'IsFinal=True' \
        'UUID=ilex-installer.x86_64' \
        > /.buildstamp

# What `lorax` normally does to make `anaconda` run; this is the bare minimum.
RUN echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd && \
    echo "install::14438:0:99999:7:::" >> /etc/shadow && \
    passwd -d root
RUN mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives && \
    mv /etc/yum.repos.d /etc/anaconda.repos.d && \
    ln -s /lib/systemd/system/anaconda.target /etc/systemd/system/default.target && \
    rm -v /usr/lib/systemd/system-generators/systemd-gpt-auto-generator
RUN ln -s /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service
RUN mkdir -p /usr/lib/systemd/logind.conf.d
COPY <<EOT /usr/lib/systemd/logind.conf.d/anaconda-shell.conf
[Login]
ReserveVT=2
EOT

# Rebuild the initramfs with the anaconda dracut module (and the buildstamp,
# as lorax does).
RUN mkdir "$(realpath /root)" && \
    kernel=$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version') && \
    DRACUT_NO_XATTR=1 dracut --force -v --zstd --reproducible --no-hostonly \
        --add "anaconda" \
        --install /.buildstamp \
        "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"

# Anaconda runs as root, which user-level pipewire refuses by default.
RUN mkdir /etc/systemd/user/pipewire.service.d/
COPY <<EOT /etc/systemd/user/pipewire.service.d/allowroot.conf
[Unit]
ConditionUser=
EOT
RUN mkdir /etc/systemd/user/pipewire.socket.d/
COPY <<EOT /etc/systemd/user/pipewire.socket.d/allowroot.conf
[Unit]
ConditionUser=
EOT
